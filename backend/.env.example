# Copia este archivo como ".env" (en la carpeta backend) y completa los valores.
# ".env" esta en .gitignore: no lo subas a GitHub.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://TU-REF.supabase.co
# Supabase -> Project Settings -> API Keys -> clave PUBLICABLE (sb_publishable_...)
# o la "anon" clasica (eyJ...). NUNCA la secret ni service_role.
# Sin comillas ni espacios; guarda el archivo como UTF-8 sin BOM.
SUPABASE_ANON_KEY=
# SOLO si el proyecto firma los JWT con el secreto antiguo HS256
# (Project Settings -> JWT Keys -> Legacy JWT Secret). Si usas claves
# asimetricas (ES256/RS256), dejalo vacio: se leen de la URL JWKS del proyecto.
SUPABASE_JWT_SECRET=

# Opcional
# Milisegundos sin peticiones de la app antes de detener el carro (parada segura)
# SMARTCAR_SILENCIO_MS=3000
# Origenes web permitidos por CORS, separados por coma (por defecto: *)
# SMARTCAR_CORS_ORIGINS=http://localhost:8081
